# Copy this file to ".env" for local dev, then `npm start`.
# In production (Vercel) these are set in the project's Environment Variables instead.

# ---- Storage --------------------------------------------------------------
# Leave DATABASE_URL unset for local dev -> data is stored in ./data/ (JSON files).
# Set it (Vercel's Neon integration provides it automatically) -> data is stored in Postgres.
# DATABASE_URL=postgres://...

# ---- Access (optional) ---------------------------------------------------
# When both are set, the whole app requires this shared username/password.
# Leave unset for an open local instance.
# AUTH_USER=team
# AUTH_PASS=change-me

# ---- Jira integration (optional) ---------------------------------------
# Enables auto-filling task titles from issue keys and importing sprints.
JIRA_BASE_URL=https://adramatch.jira.com
JIRA_EMAIL=you@adra.com
JIRA_API_TOKEN=
# The agile board to import sprints from — the number in your board URL
# (.../jira/software/c/projects/AB/boards/27/backlog  ->  27)
JIRA_BOARD_ID=27

# ---- Misc --------------------------------------------------------------
# PORT=4319   # local port (default 4319)
